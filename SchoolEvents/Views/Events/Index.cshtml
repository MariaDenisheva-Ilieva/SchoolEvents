@model IEnumerable<SchoolEvents.Models.Event>

@{
    ViewData["Title"] = "Училищни събития";
}

<h1>Училищни събития</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Създай ново събитие
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Заглавие</th>
            <th>Дата и час</th>
            <th>Място</th>
            <th>Категория</th>
            <th>Организатор</th>
            <th>Действия</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.EventDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@item.Location</td>
                <td>@item.Category.Name</td>
                <td>@item.Organizer.Name</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id">Детайли</a> |

                    <a asp-action="Edit"
                       asp-route-id="@item.Id">Редактирай</a> |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>