@model IEnumerable<SchoolEvents.Models.Event>

@{
    ViewData["Title"] = "Училищни събития";
}

<h1>Училищни събития</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Създай ново събитие
    </a>
</p>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-6">

            <label class="form-label">
                Търсене на събитие
            </label>

            <div class="input-group">

                <input type="text"
                       name="searchString"
                       value="@ViewBag.SearchString"
                       class="form-control"
                       placeholder="Въведете заглавие, описание или място..." />

                <button type="submit"
                        class="btn btn-primary">
                    Търси
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Изчисти
                </a>

            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        Няма намерени събития.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Заглавие</th>
                <th>Дата и час</th>
                <th>Място</th>
                <th>Категория</th>
                <th>Организатор</th>
                <th>Действия</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>

                    <td>
                        @item.EventDate.ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>@item.Location</td>

                    <td>@item.Category.Name</td>

                    <td>@item.Organizer.Name</td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                            Детайли
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Редактирай
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Изтрий
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}