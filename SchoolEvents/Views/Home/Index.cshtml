@{
    ViewData["Title"] = "Начало";
}

<div class="text-center mb-5">
    <h1 class="display-4">Училищни събития</h1>

    <p class="lead">
        Добре дошли в системата за управление на училищни събития.
    </p>

    <p>
        Тук можете да разглеждате предстоящите събития,
        техните категории и организатори.
    </p>
</div>

<div class="row text-center">

    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">

                <h3 class="card-title">
                    Събития
                </h3>

                <p class="card-text">
                    Разгледайте всички училищни събития,
                    техните дати, места и подробности.
                </p>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-primary">
                    Виж събитията
                </a>

            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">

                <h3 class="card-title">
                    Категории
                </h3>

                <p class="card-text">
                    Разгледайте категориите,
                    към които принадлежат училищните събития.
                </p>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-primary">
                    Виж категориите
                </a>

            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">

                <h3 class="card-title">
                    Организатори
                </h3>

                <p class="card-text">
                    Разгледайте информация за организаторите
                    на училищните събития.
                </p>

                <a asp-controller="Organizers"
                   asp-action="Index"
                   class="btn btn-primary">
                    Виж организаторите
                </a>

            </div>
        </div>
    </div>

</div>