@model IEnumerable<SchoolEvents.Models.Organizer>

@{
    ViewData["Title"] = "Организатори";
}

<h1>Организатори</h1>

<p class="text-muted">
    Организатори на училищните събития
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>№</th>
            <th>Име</th>
            <th>Имейл</th>
            <th>Телефон</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var organizer in Model)
        {
            <tr>
                <td>@organizer.Id</td>
                <td>@organizer.Name</td>
                <td>@organizer.Email</td>

                <td>
                    @if (string.IsNullOrEmpty(organizer.PhoneNumber))
                    {
                        <span>Няма въведен телефон</span>
                    }
                    else
                    {
                        @organizer.PhoneNumber
                    }
                </td>
            </tr>
        }
    </tbody>
</table>