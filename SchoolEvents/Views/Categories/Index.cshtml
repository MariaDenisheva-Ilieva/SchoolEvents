@model IEnumerable<SchoolEvents.Models.Category>

@{
    ViewData["Title"] = "Категории";
}

<h1>Категории</h1>

<p class="text-muted">
    Категории на училищните събития
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>№</th>
            <th>Име на категорията</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
            </tr>
        }
    </tbody>
</table>